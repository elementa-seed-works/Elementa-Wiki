# 로컬에서 sync.mjs 를 돌릴 때 쓰는 값. 이 파일을 .env 로 복사해 채운다.
# .env 는 커밋되지 않는다(.gitignore). GitHub Actions 는 Secrets/Variables 를 쓰므로 이 파일이 필요 없다.

# Notion 내부 통합(integration) 토큰 — https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 트리 루트 페이지 ID (SeedWork)
NOTION_ROOT_PAGE_ID=37335566982b8053ace6d928bdf49f47

# 위키 Home 에 표시할 페이지 ID (Main). 비우면 루트 페이지 내용이 Home 이 된다.
NOTION_HOME_PAGE_ID=3ab35566982b80a09a8ce9d306179d2f

# 사이드바/푸터에 쓰는 위키 이름
WIKI_TITLE=Elementa Wiki

# 데이터베이스 계층을 만드는 자기참조 관계 속성 이름.
# 비우면 스키마에서 자동 추론한다(이름에 "상위"/"부모"/"parent" 가 들어간 관계).
# NOTION_DB_PARENT_PROP=상위 항목

# 트리에서 통째로 빼고 싶은 페이지/데이터베이스 ID (쉼표 구분).
# 예: Main 안에 인라인으로 박힌 "공모전 일정" 데이터베이스를 위키 문서로 만들지 않기.
# NOTION_SKIP_IDS=0e135566982b8305adf08109189cd308

# 1 이면 이미지 다운로드를 건너뛴다(빠른 반복 확인용).
# SKIP_IMAGES=0

# 1 이면 상태 파일을 무시하고 모든 페이지를 다시 변환한다(증분 결과가 의심스러울 때).
# FORCE_FULL=0

# 노션 요청 사이 최소 간격(ms). 노션 제한은 통합당 평균 초당 3회다.
# 429 가 계속 나면 올리고, 문서가 많아 느리면 조금 낮춘다.
# NOTION_MIN_INTERVAL_MS=350

# 429·일시적 5xx 재시도 횟수.
# NOTION_MAX_RETRIES=5
